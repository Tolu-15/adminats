# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Cloudflare R2 ---
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=your-r2-bucket-name
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-your-cloudflare-account-id.r2.dev

# --- App ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Used by next.config.js to set the CORS Access-Control-Allow-Origin header.
# Set this to your production domain (e.g. https://adminats.vercel.app)
NEXT_PUBLIC_APP_URL=https://adminats.vercel.app


